# Saffron House backend — environment variables
# Copy to .env and fill in values. Do NOT commit .env.

# Server port
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT signing secret — must be a random string of at least 32 characters
# Generate with: openssl rand -hex 32
JWT_SECRET=

# JWT expiry (e.g. 7d, 1h)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,https://saffronhousehotel.vercel.app

# Set to "true" when behind a reverse proxy (Railway/Vercel/Nginx)
TRUST_PROXY=true

# Admin password used to seed the first admin user (min 10 chars)
ADMIN_PASSWORD=
